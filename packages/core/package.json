{
  "name": "my-datepicker-core",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.global.js"
    },
    "./styles.css": "./dist/datepicker.css"
  },
  "sideEffects": ["**/*.css"],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "description": "Framework-agnostic multi-calendar datepicker core with Jalali, Hijri, and Gregorian support.",
  "keywords": ["datepicker", "calendar", "jalali", "persian", "hijri", "gregorian", "framework-agnostic", "smartdate"],
  "homepage": "https://github.com/haedarfarhani/date-picker-javascript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haedarfarhani/date-picker-javascript.git"
  },
  "bugs": {
    "url": "https://github.com/haedarfarhani/date-picker-javascript/issues"
  },
  "license": "MIT"
}